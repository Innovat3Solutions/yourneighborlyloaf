# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# --- Owner order notifications ---------------------------------------------
# When an order is placed, /api/orders notifies the owner over both channels
# below. Each is optional; configure one or both. Server-only — never exposed
# to the browser bundle.

# Email via Resend (https://resend.com). Create an API key in the dashboard.
# OWNER_EMAIL is where order emails are delivered.
# RESEND_FROM is optional; defaults to onboarding@resend.dev (works without a
# verified domain, but can only send to your own Resend account email until you
# verify a domain).
RESEND_API_KEY="re_..."
OWNER_EMAIL="innovat3solutions@gmail.com"
RESEND_FROM="Neighborly Loaf <onboarding@resend.dev>"

# SMS via Twilio (https://twilio.com). From the Twilio console:
#   TWILIO_ACCOUNT_SID + TWILIO_AUTH_TOKEN from the dashboard,
#   TWILIO_FROM = a Twilio phone number you own (E.164, e.g. +1...),
#   OWNER_PHONE = where order texts are delivered (E.164).
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="your-auth-token"
TWILIO_FROM="+1..."
OWNER_PHONE="+17864139347"

# PORT: Port the Express API/static server listens on. Defaults to 8787 in dev.
# Cloud Run injects this automatically in production.
PORT=8787
