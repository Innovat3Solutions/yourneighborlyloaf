# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# --- Owner order notifications ---------------------------------------------
# When an order is placed, /api/orders emails the full order to the owner.
# Server-only — never exposed to the browser bundle.

# WEB3FORMS_ACCESS_KEY: default delivery path (no dashboard account needed).
# Get a key at https://web3forms.com — enter yourneighborlyloaf@gmail.com and
# the access key is emailed to you. The key itself sets the destination inbox.
WEB3FORMS_ACCESS_KEY="your-web3forms-access-key"

# Optional upgrade: set RESEND_API_KEY (https://resend.com) to deliver via
# Resend instead — branded and most robust. Requires OWNER_EMAIL as the
# destination. RESEND_FROM is optional (defaults to onboarding@resend.dev).
# RESEND_API_KEY="re_..."
# OWNER_EMAIL="yourneighborlyloaf@gmail.com"
# RESEND_FROM="Neighborly Loaf <onboarding@resend.dev>"

# PORT: Port the Express API/static server listens on. Defaults to 8787 in dev.
# Cloud Run injects this automatically in production.
PORT=8787
